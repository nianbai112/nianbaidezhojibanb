# =============================================================================
# 灵萌 / XiaoYi 校园综合平台 — 环境变量模板
# =============================================================================
# 使用说明:
#   1. 客户首次部署必须保持 DB_IS_INSTALLED=0、SETUP_WIZARD=true
#   2. 打开后台后进入安装向导，填写数据库、Redis、管理员密码和后台域名
#   3. 安装向导成功后系统会自动写入 DB_IS_INSTALLED=1、SETUP_WIZARD=false
#   4. 小程序、对象存储、支付等业务配置可以进入后台后再补齐
# =============================================================================
# 重要: 不要将 .env 中的真实密码提交到 Git 仓库！
# =============================================================================

# ---- 运行模式 ----
# 可选值: development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SERVICE_ROLE=api
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
# PM2 单机 Realtime 进程数。1 为默认，增加前先确认 Redis 和负载。
REALTIME_INSTANCES=1
API_PREFIX=/api/v1
APP_VERSION=1.0.45-selfhosted.1

# ---- 数据库 ----
# 宝塔客户默认推荐 MySQL；懂 PostgreSQL 的客户也可以改成 postgresql。
# 可选：mysql / postgresql。首次安装后不要随意切换数据库类型。
DB_PROVIDER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lingmeng
DB_PASSWORD=
DB_NAME=lingmeng
DB_SCHEMA=public
DB_CHARSET=utf8mb4
DATABASE_URL=

# 系统是否安装成功：0 未安装/强制进入安装向导，1 已安装/进入正式后台。
DB_IS_INSTALLED=0
SETUP_WIZARD=true

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 密码（如无密码可不填）
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT 认证 ----
# 访问令牌过期时间
JWT_ACCESS_EXPIRES_IN=2h
# 刷新令牌过期时间
JWT_REFRESH_EXPIRES_IN=7d
RIDER_REFRESH_EXPIRES_IN=30d
JWT_SECRET=ChangeThisJwtSecret
# 商家云打印凭证（飞鹅 UKEY、易联云 Client Secret）的独立加密密钥，至少 32 个随机字符。
PRINT_CREDENTIAL_KEY=
# 管理员专用 JWT 密钥（可选，不填则使用 JWT_SECRET）
# 如果填写，管理员 token 将使用此密钥签发，与用户 token 密钥分离
ADMIN_JWT_SECRET=ChangeThisAdminJwtSecret

# ---- 初始超级管理员 ----
# 首次安装会创建一次，后续不会覆盖已存在账号。
# 后台登录账号：admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD

# ---- 校园地图 CAD 转换 ----
# 服务器需要自动导入 DWG 时安装 ODA File Converter，并填写可执行文件绝对路径。
# 常见 Linux 路径：/usr/bin/ODAFileConverter 或 /opt/ODAFileConverter/ODAFileConverter
# 不填时后端会自动探测常见路径；DXF/GeoJSON/图片导入不依赖此项。
ODA_FILE_CONVERTER=

# ---- 微信小程序 ----
# 首次安装可以留空，进入后台后在系统配置里补齐。
WX_MINI_APPID=
WX_MINI_SECRET=

# ---- 阿里云短信服务 (手机号验证码登录需要) ----
# 开通路径：阿里云控制台 → 短信服务。签名和模板必须审核通过。
# 模板变量必须包含 ${code}，例如：您的验证码为${code}，5分钟内有效。
# 本地开发 NODE_ENV!=production 时不会真实发短信，会返回本地测试验证码。
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou

# ---- 微信支付 V3 (选填，支付功能需要) ----
# 微信商户平台 → 账户中心 → API 安全
# WX_PAY_MCHID=<CHANGE_ME>
# WX_PAY_APIV3_KEY=<CHANGE_ME>
# WX_PAY_CERT_SERIAL_NO=<CHANGE_ME>
# WX_PAY_PRIVATE_KEY_PATH=<CHANGE_ME>
# WX_PAY_PLATFORM_CERT_PATH=<CHANGE_ME>
# WX_PAY_NOTIFY_URL=<CHANGE_ME>
# WX_PAY_REFUND_NOTIFY_URL=<CHANGE_ME>

# ---- 腾讯云 COS 对象存储 (选填，文件上传需要) ----
# 腾讯云控制台 → 对象存储 → 密钥管理
# COS_SECRET_ID=<CHANGE_ME>
# COS_SECRET_KEY=<CHANGE_ME>
# COS_BUCKET=<CHANGE_ME>
# COS_REGION=<CHANGE_ME>
# COS_DOMAIN=<CHANGE_ME>

# ---- 跨域 (CORS) ----
# 允许的前端域名（多个用逗号分隔）
# 开发环境可使用 true
# 生产环境必填，如: https://admin.yuntingzhe.cn
CORS_ORIGIN=true

# ---- 文件上传限制 ----
UPLOAD_IMAGE_MAX_SIZE_MB=10
UPLOAD_VIDEO_MAX_SIZE_MB=100

# ---- 速率限制 ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MESSAGE=请求过于频繁，请稍后再试
# 认证接口限流（次/分钟）
AUTH_THROTTLE_LIMIT=5
ADMIN_AUTH_THROTTLE_LIMIT=30

# ---- AI / 机器人 (选填) ----
# 如需使用机器人发帖/评论功能，请填写以下至少一个
# AI_API_KEY=<CHANGE_ME>
# OPENAI_API_KEY=<CHANGE_ME>
# DEEPSEEK_API_KEY=<CHANGE_ME>

# ---- 运维 ----
# 后端重启命令（可选，如 pm2 restart backend）
# 可选：后台运维一键重启。微服务部署推荐同时重启三个进程。
# OPS_RESTART_COMMAND="pm2 restart lingmeng-worker lingmeng-realtime lingmeng-backend --update-env"
OPS_RESTART_COMMAND=
OPS_RESTART_COOLDOWN_SECONDS=300
OPS_LOG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 朋友圈自动同步：审核通过的帖子生成海报，每半小时合并成一条朋友圈（最多 9 张，纯图片）
# 推荐在后台「内容中心 → 朋友圈同步」里填写 app_key 等并扫码登录（后台填写的优先），下面的变量只是备用。
# 服务器需安装中文字体（如 fonts-noto-cjk / font-noto-cjk）
# ---------------------------------------------------------------------------
WECHAT_MOMENTS_ENABLED=
# 只同步此时间之后发布的帖子（ISO 时间）；留空=以第一次运行时间为准
WECHAT_MOMENTS_SINCE=
# 海报小程序码记在哪个用户名下（留空=帖子作者）
WECHAT_MOMENTS_SHARER_USER_ID=
# 海报字体（默认 Noto Sans CJK SC），或直接指定字体文件路径
WECHAT_MOMENTS_FONT=
WECHAT_MOMENTS_FONT_FILE=
WECHATPAD_BASE_URL=
WECHATPAD_APP_KEY=
WECHATPAD_APP_SECRET=
WECHATPAD_DEVICE_ID=
# 图片服务(wxcdnd)地址：需自行部署，网关本身不提供朋友圈图片上传
WECHATPAD_CDN_BASE_URL=
WECHATPAD_CDN_TOKEN=
WECHATPAD_WEBHOOK_SECRET=
WECHATPAD_TIMEOUT_MS=30000

# ---- uni-app x App 登录（留空时禁用对应渠道）----
# 微信开放平台“移动应用”凭据；严禁填写小程序 secret 或放入客户端。
WX_APP_APPID=
WX_APP_SECRET=
# 确认移动应用与小程序已绑定同一开放平台账号后，填写该账号的稳定唯一标识。
# 留空时不按 UnionID 关联历史账号。上线前配置；运行后不要随意改变该命名空间。
WX_OPEN_PLATFORM_ACCOUNT_ID=
# 公众号确认绑定同一开放平台账号后，填写与上面相同的值；留空关闭 UnionID 自动绑定，扫码绑定仍可用。
WX_OFFICIAL_OPEN_PLATFORM_ACCOUNT_ID=
# Apple 原生 App 的 Bundle ID、Team ID、Key ID 与 Sign in with Apple 私钥。
# 私钥通过部署密钥管理注入，单行 PEM 可用 \n 表示换行；不得进入前端。
APPLE_APP_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Apple 刷新凭证的独立 AES-256-GCM 密钥，不得复用 JWT_SECRET。
# KEYS 为 JSON 对象：键是密钥版本 ID，值是随机 32 字节的标准 base64。
# KEY_ID 指向当前加密版本；轮换时保留旧键直到对应队列处理完毕。
APPLE_TOKEN_ENCRYPTION_KEY_ID=
APPLE_TOKEN_ENCRYPTION_KEYS=

# 服务端省市区校验使用腾讯 WebService，和 Android/iOS SDK Key 分开管理。
# 控制台启用 WebService 并限制服务器 IP；启用签名校验时填写 SECRET。
TENCENT_MAP_WEB_SERVICE_KEY=
TENCENT_MAP_WEB_SERVICE_SECRET=
