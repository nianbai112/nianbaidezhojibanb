# =============================================================================
# 灵萌 / XiaoYi 校园综合平台 — 环境变量模板
# =============================================================================
# 使用说明:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 替换所有 <CHANGE_ME> 占位符为真实值
#   3. 生成 JWT_SECRET:     openssl rand -hex 32
#   4. 生成管理员密码:      使用强密码管理器生成（至少12位，含大小写+数字+符号）
#   5. 生产部署:            SETUP_WIZARD=false，所有 <CHANGE_ME> 必须已替换
# =============================================================================
# 重要: 不要将 .env 中的真实密码提交到 Git 仓库！
# =============================================================================

# ---- 运行模式 ----
# 可选值: development | production | test
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# 安装向导: 首次部署时设为 true，初始化完成后必须移除
# SETUP_WIZARD=true
# 安装向导 Token: 用于保护 /setup 写接口
# 生成方式: openssl rand -hex 16
# SETUP_TOKEN=<CHANGE_ME>

# ---- 数据库 (必填) ----
# PostgreSQL 连接串
# 格式: postgresql://用户:密码@主机:5432/数据库?schema=public
# DATABASE_URL=<CHANGE_ME>

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 密码（如无密码可不填）
# REDIS_PASSWORD=<CHANGE_ME>

# ---- JWT 认证 (必填) ----
# 访问令牌过期时间
JWT_ACCESS_EXPIRES_IN=2h
# 刷新令牌过期时间
JWT_REFRESH_EXPIRES_IN=7d
# JWT 签名密钥: 至少 32 位随机字符串
# 生成命令: openssl rand -hex 32
# JWT_SECRET=<CHANGE_ME>
# 管理员专用 JWT 密钥（可选，不填则使用 JWT_SECRET）
# 如果填写，管理员 token 将使用此密钥签发，与用户 token 密钥分离
# JWT_SECRET_ADMIN=<CHANGE_ME>

# ---- 微信小程序 (必填) ----
# 微信公众平台 → 开发 → 开发管理 → 开发设置
# WX_MINI_APPID=<CHANGE_ME>
# WX_MINI_SECRET=<CHANGE_ME>

# ---- 微信支付 V3 (选填，支付功能需要) ----
# 微信商户平台 → 账户中心 → API 安全
# WX_PAY_MCHID=<CHANGE_ME>
# WX_PAY_APIV3_KEY=<CHANGE_ME>
# WX_PAY_CERT_SERIAL_NO=<CHANGE_ME>
# WX_PAY_PRIVATE_KEY_PATH=<CHANGE_ME>
# WX_PAY_PLATFORM_CERT_PATH=<CHANGE_ME>
# WX_PAY_NOTIFY_URL=<CHANGE_ME>
# WX_PAY_REFUND_NOTIFY_URL=<CHANGE_ME>

# ---- 腾讯云 COS 对象存储 (选填，文件上传需要) ----
# 腾讯云控制台 → 对象存储 → 密钥管理
# COS_SECRET_ID=<CHANGE_ME>
# COS_SECRET_KEY=<CHANGE_ME>
# COS_BUCKET=<CHANGE_ME>
# COS_REGION=<CHANGE_ME>
# COS_DOMAIN=<CHANGE_ME>

# ---- 跨域 (CORS) ----
# 允许的前端域名（多个用逗号分隔）
# 开发环境可使用 true
# 生产环境必填，如: https://admin.yuntingzhe.cn
CORS_ORIGIN=true

# ---- 文件上传限制 ----
UPLOAD_IMAGE_MAX_SIZE_MB=10
UPLOAD_VIDEO_MAX_SIZE_MB=100

# ---- 速率限制 ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# 认证接口限流（次/分钟）
AUTH_THROTTLE_LIMIT=5
ADMIN_AUTH_THROTTLE_LIMIT=30

# ---- AI / 机器人 (选填) ----
# 如需使用机器人发帖/评论功能，请填写以下至少一个
# AI_API_KEY=<CHANGE_ME>
# OPENAI_API_KEY=<CHANGE_ME>
# DEEPSEEK_API_KEY=<CHANGE_ME>

# ---- 运维 ----
# 后端重启命令（可选，如 pm2 restart backend）
OPS_RESTART_COMMAND=
OPS_RESTART_COOLDOWN_SECONDS=300
OPS_LOG_RETENTION_DAYS=30
