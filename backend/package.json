{
  "name": "lingmeng-backend",
  "version": "1.0.36",
  "description": "灵萌/xiaoyi 小程序后端服务 - 区域/校园生活服务平台",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "engine.io": "6.6.9",
    "form-data": "4.0.6",
    "socket.io-adapter": "2.5.8",
    "ws": "$ws"
  },
  "scripts": {
    "build": "npm run db:generate && rm -rf dist && nest build && npx tsc --project tsconfig.json --incremental false && if [ -d \"dist/src 2\" ]; then mkdir -p dist/src && cp -R \"dist/src 2\"/. dist/src/ && rm -rf \"dist/src 2\"; fi && if [ -d \"dist/src/modules 2\" ]; then mkdir -p dist/src/modules && cp -R \"dist/src/modules 2\"/. dist/src/modules/ && rm -rf \"dist/src/modules 2\"; fi && rm -rf \"dist 2\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "if [ -d \"dist/src 2\" ]; then mkdir -p dist/src && cp -R \"dist/src 2\"/. dist/src/ && rm -rf \"dist/src 2\"; fi && if [ -d \"dist/src/modules 2\" ]; then mkdir -p dist/src/modules && cp -R \"dist/src/modules 2\"/. dist/src/modules/ && rm -rf \"dist/src/modules 2\"; fi && node dist/src/main.js",
    "lint": "npm run lint:check",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:sync-schemas": "node scripts/sync-prisma-schema-variants.cjs",
    "db:generate": "node scripts/sync-prisma-schema-variants.cjs --generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.5.1",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^5.7.1",
    "archiver": "^5.3.2",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.4",
    "jsqr": "^1.4.0",
    "miniprogram-automator": "^0.12.1",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.12",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
