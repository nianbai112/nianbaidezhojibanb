// ==================== 机器人系统 ====================

model BotAccount {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId      String?
  persona        BotPersona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  regionId       String?
  tags           Json?
  status         String      @default("active") // active, paused, disabled, risk_locked, error_paused
  dailyLimit     Int         @default(10)
  failureCount   Int         @default(0)
  riskLevel      String      @default("normal")
  lastExecutedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tasks      BotPostTask[]
  actionLogs BotActionLog[]

  @@map("bot_accounts")
}

model BotPersona {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  gender    Gender   @default(UNKNOWN)
  ageRange  String?
  style     String?
  bio       String?  @db.Text
  prompt    String?  @db.Text
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots BotAccount[]

  @@map("bot_personas")
}

model BotPostTask {
  id                  String     @id @default(cuid())
  botId               String
  bot                 BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  type                String     @default("post") // post, comment
  title               String?
  content             String?    @db.Text
  regionId            String?
  circleId            String?
  topicId             String?
  targetPostId        String?
  mediaUrls           Json?
  status              String     @default("pending") // pending, approved, running, completed, failed
  source              String     @default("admin")
  priority            Int        @default(0)
  retryCount          Int        @default(0)
  maxRetryTimes       Int        @default(1)
