  region   Region @relation(fields: [regionId], references: [id])
  operator User?  @relation("OperatorRegionBalanceLogs", fields: [operatorId], references: [id])

  @@index([regionId, createdAt])
  @@map("region_balance_logs")
}

// ==================== 消息系统 ====================

model Conversation {
  id               String    @id @default(cuid())
  type             String    @default("private") // private, group, circle
  title            String?
  avatar           String?
  regionId         String? // 会话区域归属
  lastMessage      String?
  lastMsgTime      DateTime?
  unreadCount      Int       @default(0)
  isBlocked        Boolean   @default(false)
  serviceStatus    String    @default("pending") // pending, processing, resolved, rejected
  serviceHandlerId String?
  serviceHandledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([regionId])
  @@index([serviceStatus, lastMsgTime])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
