  content       String
  providerJobId String?
  attempts      Int      @default(0)
  errorMessage  String?
  sentAt        DateTime?
  printedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@map("print_jobs")
}

