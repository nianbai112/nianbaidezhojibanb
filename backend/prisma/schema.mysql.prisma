  @@map("system_alerts")
}

// ==================== 统一通知中心新增表 ====================

model WechatSubscribeConsent {
  id           String   @id @default(cuid())
  userId       String
  templateType String
  templateId   String
  status       String // accept / reject / ban / unknown
  sourceScene  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, templateType])
  @@index([userId, status])
  @@map("wechat_subscribe_consents")
}

model WechatMessageLog {
  id           String    @id @default(cuid())
  userId       String?
  openid       String?
  platformType String // miniprogram / official
  templateType String
  templateId   String
  page         String?
  payload      Json?
  status       String // pending / success / failed
  errorCode    String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, platformType, createdAt])
  @@index([status, createdAt])
  @@map("wechat_message_logs")
}

model WechatOfficialBinding {
  id             String    @id @default(cuid())
  userId         String
  officialOpenid String    @unique
  unionid        String?
  subscribe      Boolean   @default(false)
  subscribeAt    DateTime?
  unsubscribedAt DateTime?
  qrScene        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId])
  @@index([unionid])
  @@map("wechat_official_bindings")
}

model RealtimeSession {
  id         String   @id @default(cuid())
  userId     String?
  adminId    String?
  socketId   String
  platform   String // miniapp / admin
  online     Boolean  @default(true)
  ip         String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, online])
  @@index([adminId, online])
  @@index([platform, online])
  @@map("realtime_sessions")
}
