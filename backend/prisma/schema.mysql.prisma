  remark       String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("city_agent_settlements")
}

model OrderLog {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action       String // PENDING_PAY, PAID, SHIPPED, DELIVERED, RECEIVED, COMPLETED, CANCELLED, REFUNDING, REFUNDED
  fromStatus   String?
  toStatus     String?
  operatorId   String?
  operatorType String? // admin, user, system
  remark       String?
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_logs")
}

// ==================== 平台财务 ====================

model PlatformLedger {
  id          String   @id @default(cuid())
  orderNo     String?
  orderType   String // order, mall_order, delivery_order, errand_order, recharge, topup
  amount      Decimal  @db.Decimal(12, 2)
  fee         Decimal  @default(0) @db.Decimal(12, 2)
  type        String // income, refund, commission, penalty
  channel     String? // wx_pay, ali_pay, balance
  status      String   @default("pending") // pending, completed, failed
  description String?
  createdAt   DateTime @default(now())

  @@index([orderType, createdAt])
  @@index([type, status])
  @@map("platform_ledgers")
}

model SubsidyLedger {
  id           String    @id @default(cuid())
  subsidyNo    String    @unique
  sourceType   String // membership, coupon, new_user, referral, campaign, manual
  sourceId     String?
  benefitKey   String?
  campaignId   String?
  orderType    String // order, mall_order, errand_order, activity_order
  orderId      String
  orderNo      String?
  userId       String?
  payerType    String    @default("platform") // platform, merchant, region, sponsor
  payerId      String?
  receiverType String    @default("platform") // rider, merchant, platform, user
  receiverId   String?
  amount       Decimal   @db.Decimal(12, 2)
  status       String    @default("pending") // pending, locked, settled, cancelled
  settlementId String?
  description  String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  @@index([orderType, orderId])
  @@index([sourceType, benefitKey])
  @@index([payerType, status])
  @@index([receiverType, receiverId, status])
  @@index([createdAt])
  @@map("subsidy_ledgers")
}

model MerchantSettlement {
  id           String    @id @default(cuid())
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  settlementNo String    @unique
  amount       Decimal   @db.Decimal(12, 2)
  platformFee  Decimal   @default(0) @db.Decimal(12, 2)
  startAt      DateTime
  endAt        DateTime
  orderCount   Int       @default(0)
  status       String    @default("pending") // pending, processing, completed, failed
  transferNo   String?
  remark       String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 新结算单以商家和结算窗口防重；保留历史空值以兼容已存在的重复旧单据。
  periodKey String? @unique

  @@map("merchant_settlements")
}

enum RiderSettlementStatus {
  PENDING
  CONFIRMED
  PAID
  REJECTED
}

model RiderSettlement {
  id               String                @id @default(cuid())
  settlementNo     String                @unique
  riderId          String
  rider            User                  @relation("RiderSettlements", fields: [riderId], references: [id], onDelete: Cascade)
  regionId         String?
  periodStart      DateTime
  periodEnd        DateTime
  orderCount       Int                   @default(0)
  deliveryFeeTotal Decimal               @default(0) @db.Decimal(12, 2)
  rewardAmount     Decimal               @default(0) @db.Decimal(12, 2)
  penaltyAmount    Decimal               @default(0) @db.Decimal(12, 2)
  payableAmount    Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal               @default(0) @db.Decimal(12, 2)
  status           RiderSettlementStatus @default(PENDING)
  remark           String?
  confirmedBy      String?
  confirmedAt      DateTime?
  paidBy           String?
  paidAt           DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectReason     String?
  periodKey        String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            RiderSettlementItem[]

  @@index([riderId, periodStart])
  @@index([status, createdAt])
  @@map("rider_settlements")
}

model RiderSettlementItem {
  id                String          @id @default(cuid())
  settlementId      String
  settlement        RiderSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderType         String          @default("errand")
  orderId           String
  riderId           String
  deliveryFeeAmount Decimal         @default(0) @db.Decimal(12, 2)
  tipAmount         Decimal         @default(0) @db.Decimal(12, 2)
  rewardAmount      Decimal         @default(0) @db.Decimal(12, 2)
  penaltyAmount     Decimal         @default(0) @db.Decimal(12, 2)
  payableAmount     Decimal         @default(0) @db.Decimal(12, 2)
  status            String          @default("included")
  reversalAmount    Decimal         @default(0) @db.Decimal(12, 2)
  reversedAt        DateTime?
  reverseReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([orderType, orderId])
  @@index([settlementId, status])
  @@index([riderId, createdAt])
  @@map("rider_settlement_items")
}

model RiderLiability {
  id              String   @id @default(cuid())
  riderId         String
  orderId         String
  refundId        String
  amount          Decimal  @db.Decimal(12, 2)
  recoveredAmount Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("open")
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orderId, refundId])
  @@index([riderId, status])
  @@map("rider_liabilities")
}

model ErrandReview {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  riderId   String
  rating    Int
  tags      Json?
  content   String?  @db.Text
  images    Json?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId, createdAt])
  @@map("errand_reviews")
}

