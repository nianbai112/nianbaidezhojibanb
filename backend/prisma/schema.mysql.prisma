  content     String    @db.Text
  summary     String?
  imageUrl    String?
  iconUrl     String?
  tagText     String?
  tagType     String?
  status      String    @default("published") // draft, published, offline
  priority    Int       @default(0)
  actions     Json?
  extra       Json?
  createdBy   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([regionId, status, publishedAt])
  @@index([category, status, publishedAt])
  @@map("official_assistant_messages")
}

// ==================== 运营功能 ====================

model Coupon {
  id            String     @id @default(cuid())
  name          String
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minAmount     Decimal    @default(0) @db.Decimal(10, 2)
  totalCount    Int
  receivedCount Int        @default(0)
  usedCount     Int        @default(0)
  limitPerUser  Int        @default(1)
  startAt       DateTime
  endAt         DateTime
  status        String     @default("active")
  businessScope String     @default("all")
  description   String?
  code          String?    @unique
  regionId      String?
  region        Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  merchantId    String?
  merchant      Merchant?  @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  receives    CouponReceive[]
  redeemCodes CouponRedeemCode[]

  @@index([status, endAt])
  @@index([regionId])
  @@index([businessScope])
  @@map("coupons")
}

model CouponRedeemCode {
  id           String    @id @default(cuid())
  couponId     String
  coupon       Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  code         String    @unique
  batchName    String?
  status       String    @default("active")
  totalLimit   Int       @default(1)
  usedCount    Int       @default(0)
  perUserLimit Int       @default(1)
  startAt      DateTime?
  endAt        DateTime?
  regionId     String?
  remark       String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  records CouponRedeemRecord[]

  @@index([couponId, status])
  @@index([regionId])
  @@index([status, endAt])
  @@map("coupon_redeem_codes")
}

model CouponRedeemRecord {
  id           String           @id @default(cuid())
  redeemCodeId String
  redeemCode   CouponRedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Cascade)
  couponId     String
  userId       String
  receiveId    String?
  ip           String?
  createdAt    DateTime         @default(now())

  @@index([redeemCodeId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_redeem_records")
}

model CouponReceive {
  id                 String    @id @default(cuid())
  couponId           String
  coupon             Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String    @default("unused") // unused, used, expired
  usedAt             DateTime?
  orderNo            String?
  // Only populated for member-coupon issuance, so refund/revoke can expire the exact receipts.
  sourceMembershipId String?
  createdAt          DateTime  @default(now())

  @@index([sourceMembershipId, status])
  @@map("coupon_receives")
}

model CheckIn {
  id             String      @id @default(cuid())
