// ==================== 支付系统（PaymentOrder / PaymentRefund） ====================

model PaymentOrder {
  id             String    @id @default(cuid())
  paymentNo      String    @unique
  bizType        String // order, mall_order, delivery_order, errand_order, recharge, topup, activity, dating, second_hand, group_buy
  bizId          String
  orderNo        String
  userId         String
  amount         Decimal   @db.Decimal(12, 2)
  channel        String    @default("wx_pay") // wx_pay, ali_pay, balance
  status         String    @default("pending") // pending, paying, paid, failed, closed, refunding, refunded
  wxTransId      String?
  wxPrepayId     String?
  payTime        DateTime?
  expireTime     DateTime?
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refunds            PaymentRefund[]
  reservationRelease PaymentReservationRelease?

  @@index([bizType, bizId])
  @@index([orderNo])
  @@index([userId, createdAt])
  @@index([status])
  @@map("payment_orders")
}

model PaymentReservationRelease {
  id          String       @id @default(cuid())
  paymentId   String       @unique
  payment     PaymentOrder @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status      String       @default("pending") // pending, processing, failed, completed
  attempts    Int          @default(0)
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, updatedAt])
  @@map("payment_reservation_releases")
}

model PaymentRefund {
  id         String       @id @default(cuid())
  refundNo   String       @unique
  paymentId  String
  payment    PaymentOrder @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount     Decimal      @db.Decimal(12, 2)
  reason     String?
  wxRefundId String?
  status     String       @default("pending") // pending, processing, success, failed
  failReason String?
  sourceType String?
  sourceId   String?
  refundedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([paymentId])
  @@index([sourceType, sourceId])
  @@map("payment_refunds")
}

// ==================== 管理员系统（独立建模） ====================

model AdminAccount {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  realName              String
  avatar                String?
  phone                 String?
  email                 String?
  status                String    @default("active") // active, disabled, deleted
  loginFailCount        Int       @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  passwordResetRequired Boolean   @default(false)
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?
  deletedAt             DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  lastLoginUserAgent    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  roles           AdminAccountRole[]
  managedRegions  Region[]              @relation("RegionManagerAccount")
  operationLogs   AdminOperationLog[]
  loginLogs       AdminLoginLog[]
  wechatBinding   AdminWechatBinding?
  qrLoginSessions AdminQrLoginSession[]

  @@map("admin_accounts")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AdminRolePermission[]
  menus       AdminRoleMenu[]
  accounts    AdminAccountRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id           String          @id @default(cuid())
  roleId       String
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminMenu {
  id         String      @id @default(cuid())
  parentId   String?
  parent     AdminMenu?  @relation("MenuChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   AdminMenu[] @relation("MenuChildren")
  name       String
  icon       String?
  path       String?
  component  String?
  type       String      @default("menu") // menu, button, api
  permission String?
  sortOrder  Int         @default(0)
  isHidden   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  roles AdminRoleMenu[]

  @@map("admin_menus")
}

model AdminRoleMenu {
  id     String    @id @default(cuid())
  roleId String
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuId String
  menu   AdminMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("admin_role_menus")
}

model AdminAccountRole {
  id        String       @id @default(cuid())
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roleId    String
  role      AdminRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  regionId  String?

  @@unique([accountId, roleId, regionId])
  @@map("admin_account_roles")
}

model AdminOperationLog {
  id         String       @id @default(cuid())
  accountId  String
  account    AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  action     String
  module     String
  targetId   String?
  targetType String?
  detail     Json?
  ip         String?
  ua         String?
  createdAt  DateTime     @default(now())

  @@index([accountId, createdAt])
  @@index([action, module])
  @@map("admin_operation_logs")
}

model AdminLoginLog {
  id         String       @id @default(cuid())
  accountId  String
  account    AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ip         String?
  ua         String?
  success    Boolean      @default(true)
  failReason String?
  createdAt  DateTime     @default(now())

  @@index([accountId, createdAt])
  @@map("admin_login_logs")
}

model AdminWechatBinding {
  id          String                   @id @default(cuid())
  accountId   String                   @unique
  account     AdminAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String                   @unique
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openid      String?
  unionid     String?
  nickname    String?
  avatar      String?
  status      AdminWechatBindingStatus @default(ACTIVE)
  boundAt     DateTime                 @default(now())
  lastLoginAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([openid])
  @@index([unionid])
  @@map("admin_wechat_bindings")
}

model AdminQrLoginSession {
  id            String             @id @default(cuid())
  ticket        String             @unique
  status        AdminQrLoginStatus @default(PENDING)
  accountId     String?
  account       AdminAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  openid        String?
  nickname      String?
  avatar        String?            @db.Text
  webIp         String?
  webUserAgent  String?            @db.Text
  scanIp        String?
  scanUserAgent String?            @db.Text
  rejectReason  String?            @db.Text
  expiresAt     DateTime
  scannedAt     DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, expiresAt])
  @@index([userId])
  @@index([accountId])
  @@map("admin_qr_login_sessions")
}

model Reconciliation {
