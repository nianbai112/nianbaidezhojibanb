// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举定义 ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  DELETED
}

enum AdminWechatBindingStatus {
  ACTIVE
  DISABLED
}

enum AdminQrLoginStatus {
  PENDING
  SCANNED
  CONFIRMED
  EXPIRED
  CANCELED
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
}

enum StudentVerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  REGION_ADMIN
  MERCHANT
  RIDER
  USER
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOTE
  REPOST
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  DELETED
  TOP
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum CircleMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CircleJoinType {
  OPEN
  APPLY
  INVITE
}

enum OrderStatus {
  PENDING_PAY
  PAID
  SHIPPED
  DELIVERED
  RECEIVED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum DeliveryOrderStatus {
  PENDING_PAY
  PENDING_ACCEPT
  ACCEPTED
  IN_PROGRESS
  ARRIVED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum DeliveryTaskType {
  PICKUP
  DELIVER
  MEAL
  UNIVERSAL
}

enum RiderStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum WalletType {
  BALANCE
  FREEZE
}

enum TransactionType {
  RECHARGE
  WITHDRAW
  PAY
  REFUND
  REWARD
  TRANSFER_IN
  TRANSFER_OUT
  COMMISSION
  PENALTY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REJECTED
}

enum PaymentChannel {
  WX_PAY
  ALI_PAY
  BALANCE
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  SYSTEM
}

enum NotificationType {
  SYSTEM
  LIKE
  COMMENT
  REPLY
  MENTION
  FOLLOW
  SQUAT
  MESSAGE
  ORDER
  DELIVERY
  REFUND
  WALLET
  CIRCLE
  CERTIFICATION
  MERCHANT
  ANNOUNCEMENT
  ADMIN_BROADCAST
}

enum CouponType {
  FULL_REDUCTION
  DISCOUNT
  EXCHANGE
}

enum CheckInType {
  DAILY
  CONTINUOUS
}

enum SecondHandStatus {
  PENDING
  ON_SALE
  SOLD
  OFFLINE
  REJECTED
}

enum MatchStatus {
  PENDING
  MATCHED
  REJECTED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  BAN
  UNBAN
}

enum PriceAdjustmentType {
  PERCENTAGE
  FIXED
}

enum PriceAdjustmentScope {
  REGION
  CATEGORY
  MERCHANT
}

// ==================== 用户与权限 ====================

model User {
  id                      String     @id @default(cuid())
  uid                     Int        @unique @default(autoincrement())
  publicUid               Int?       @unique
  openid                  String     @unique
  unionid                 String?
  avatar                  String?
  nickname                String?
  phone                   String?
  status                  UserStatus @default(ACTIVE)
  userType                Int        @default(1) // 1=normal user, 4=bot
  muteEndAt               DateTime?
  muteReason              String?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  lastLoginCountry        String?
  lastLoginProvince       String?
  lastLoginCity           String?
  lastLoginDistrict       String?
  lastLoginLocationSource String?
  lastLoginLocatedAt      DateTime?
  lastLoginDevice         String?
  lastLoginUserAgent      String?    @db.Text
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  // Relations
  profile                 UserProfile?
  settings                UserSettings?
  studentVerify           StudentVerify?
  roles                   UserRole[]
  posts                   Post[]
  postEchoInteractions    PostEchoInteraction[]
  comments                Comment[]
  postMentions            PostMention[]            @relation("MentionedPostUser")
  commentMentions         CommentMention[]         @relation("MentionedCommentUser")
  likes                   Like[]
  favorites               Favorite[]
  follows                 Follow[]                 @relation("UserFollows")
  followers               Follow[]                 @relation("UserFollowers")
  blocks                  Block[]                  @relation("UserBlocks")
  blockedBy               Block[]                  @relation("UserBlockedBy")
  browseHistory           BrowseHistory[]
  tags                    UserTag[]
  experiences             UserExperience[]
  circles                 CircleMember[]
  circlePayments          CirclePayment[]
  cartItems               Cart[]
  orders                  Order[]                  @relation("UserOrders")
  deliveryOrders          DeliveryOrder[]          @relation("UserDeliveryOrders")
  riderOrders             DeliveryOrder[]          @relation("RiderDeliveryOrders")
  wallet                  Wallet?
  transactions            WalletTransaction[]
  withdraws               Withdraw[]
  messages                Message[]                @relation("SenderMessages")
  conversations           ConversationMember[]
  notifications           Notification[]
  coupons                 CouponReceive[]
  checkIns                CheckIn[]
  badges                  UserBadge[]
  activityJoins           ActivityJoin[]
  competitionPhotos       CompetitionPhoto[]
  competitionVotes        CompetitionPhotoVote[]
  competitionRatings      CompetitionPhotoRating[]
  activityClubMembers     ActivityClubMember[]
  secondHands             SecondHand[]
  matches                 Match[]                  @relation("UserMatches")
  matchTargets            Match[]                  @relation("TargetMatches")
  netDisks                NetDisk[]
  postCollaborators       PostCollaborator[]
  reviews                 Review[]
  reports                 Report[]                 @relation("Reporter")
  reported                Report[]                 @relation("Reported")
  auditLogs               AuditLog[]
  addresses               Address[]
  titleRecords            UserTitleRecord[]
  datingProfile           DatingProfile?
  netDiskResources        NetDiskResource[]
  netDiskDownloads        NetDiskDownload[]
  netDiskComments         NetDiskComment[]
  stickers                Sticker[]
  inviterInvites          ShareInvite[]            @relation("InviterRelation")
  inviteeInvites          ShareInvite[]            @relation("InviteeRelation")
  shareRewards            ShareReward[]
  postShareLinks          PostShareLink[]          @relation("PostShareSharer")
  claimedPostShareLinks   PostShareLink[]          @relation("PostShareClaimant")
  punchInRecords          PunchInRecord[]
  punchInWishlists        PunchInWishlist[]
  punchInComments         PunchInComment[]
  userRatings             UserRating[]
  mallMerchants           MallMerchant[]
  mallOrders              MallOrder[]
  mallReviews             MallReview[]
  distributor             MallDistributor?
  groupBuyOrders          GroupBuyOrder[]
  groupBuyReviews         GroupBuyReview[]
  alipayTransfers         AlipayTransfer[]         @relation("OperatorAlipayTransfers")
  regionBalanceLogs       RegionBalanceLog[]       @relation("OperatorRegionBalanceLogs")
  activityOrders          ActivityOrder[]
  secondHandOrders        SecondHandOrder[]
  topupOrders             TopupOrder[]
  errandOrders            ErrandOrder[]
  datingOrders            DatingOrder[]
  datingQuota             DatingQuota?
  datingReportsFiled      DatingReport[]           @relation("DatingReporter")
  datingReportsAgainst    DatingReport[]           @relation("DatingReported")
  communityPayments       CommunityPayment[]
  incentiveRecords        IncentiveRecord[]
  merchants               Merchant[]
  regionRiders            RegionRider[]
  riderSettlements        RiderSettlement[]        @relation("RiderSettlements")
  cityAgent               CityAgent?
  cityAgentApplications   CityAgentApplication[]
  transferRequests        TransferRequest[]
  adminWechatBinding      AdminWechatBinding?
  adminQrLoginSessions    AdminQrLoginSession[]
  botAccount              BotAccount?
  photoContestEntries     PhotoContestEntry[]
  photoContestRatings     PhotoContestRating[]
  ratingReplies           RatingReply[]
  managedRegions          Region[]                 @relation("RegionManagerUser")
  agreementConsents       UserAgreementConsent[]
  memberships             UserMembership[]
  membershipOrders        MembershipOrder[]
  membershipBenefitGrants MembershipBenefitGrant[]
  membershipBenefitUsages MembershipBenefitUsage[]
  riderAppPasswordCredential RiderAppPasswordCredential?

  @@index([openid])
  @@index([phone])
  @@index([status])
  @@index([publicUid])
  @@index([createdAt])
  @@map("users")
}

model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  description   String?  @db.Text
  level         Int      @default(1)
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  durationDays  Int      @default(30)
  benefits      Json?
  entitlements  Json?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders      MembershipOrder[]
  memberships UserMembership[]

  @@index([isActive, sortOrder])
  @@map("membership_plans")
}

model UserMembership {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName      String
  level         Int              @default(1)
  status        String           @default("active")
  startedAt     DateTime         @default(now())
  expiredAt     DateTime
  source        String           @default("order")
  sourceOrderId String?          @unique
  sourceOrder   MembershipOrder? @relation("MembershipOrderMembership", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  benefitGrants MembershipBenefitGrant[]

  @@index([userId, status, expiredAt])
  @@index([expiredAt])
  @@map("user_memberships")
}

model MembershipBenefitGrant {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   UserMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  benefitKey   String
  benefitName  String
  category     String
  cycle        String          @default("membership")
  totalQuota   Int             @default(0)
  usedQuota    Int             @default(0)
  unlimited    Boolean         @default(false)
  discountRate Decimal?        @db.Decimal(5, 2)
  amount       Decimal?        @db.Decimal(10, 2)
  config       Json?
  status       String          @default("active")
  startedAt    DateTime        @default(now())
  expiredAt    DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  usages MembershipBenefitUsage[]

  @@index([userId, benefitKey, status, expiredAt])
  @@index([membershipId])
  @@index([benefitKey, status])
  @@map("membership_benefit_grants")
}

model MembershipBenefitUsage {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantId     String?
  grant       MembershipBenefitGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  benefitKey  String
  benefitName String
  category    String
  targetType  String?
  targetId    String?
  amount      Decimal?                @db.Decimal(10, 2)
  quantity    Int                     @default(1)
  idempotencyKey String?              @unique
  metadata    Json?
  createdAt   DateTime                @default(now())

  @@index([userId, benefitKey, createdAt])
  @@index([targetType, targetId])
  @@index([grantId])
  @@map("membership_benefit_usages")
}

model MembershipOrder {
  id           String          @id @default(cuid())
  orderNo      String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  planName     String
  amount       Decimal         @db.Decimal(10, 2)
  durationDays Int
  status       String          @default("pending")
  payChannel   String?
  paymentNo    String?
  payTime      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  membership   UserMembership? @relation("MembershipOrderMembership")

  @@index([userId, status])
  @@index([planId])
  @@index([createdAt])
  @@map("membership_orders")
}

model MembershipDisplayItem {
  id                String   @id @default(cuid())
  title             String
  subtitle          String?  @db.Text
  imageUrl          String?
  priceText         String?
  originalPriceText String?
  buttonText        String   @default("可用")
  actionType        String   @default("navigate")
  actionUrl         String?
  targetType        String?
  targetId          String?
  benefitKey        String?
  memberOnly        Boolean  @default(false)
  showWhen          String   @default("always")
  sortOrder         Int      @default(0)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isEnabled, sortOrder])
  @@index([benefitKey])
  @@map("membership_display_items")
}

model MembershipFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  scene     String   @default("miniapp")
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scene, isEnabled, sortOrder])
  @@map("membership_faqs")
}

model UserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender    Gender    @default(UNKNOWN)
  birthday  DateTime?
  bio       String?
  regionId  String?
  region    String?
  school    String?
  major     String?
  grade     String?
  dormitory String?
  wechat    String?
  qq        String?
  email     String?
  realName  String?
  idCard    String?
  updatedAt DateTime  @updatedAt

  @@index([regionId])
  @@map("user_profiles")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyLevel         Int      @default(0) // 0:公开 1:粉丝 2:互关 3:私密
  allowFollow          Boolean  @default(true)
  allowComment         Boolean  @default(true)
  allowMessage         Boolean  @default(true)
  messagePermission    Int      @default(1) // 0:所有人 1:关注我的 2:我关注的 3:互相关注 4:禁止
  likeListVisible      Boolean  @default(true)
  allowSearch          Boolean  @default(true)
  showJoinedCircles    Boolean  @default(true)
  commentPermission    Int      @default(0) // 0:所有人 1:关注我的 2:我关注的 3:互相关注 4:禁止
  replyPermission      Int      @default(0) // 0:所有人 1:关注我的 2:我关注的 3:互相关注 4:禁止
  mentionPermission    Int      @default(0) // 0:所有人 1:关注我的 2:我关注的 3:互相关注 4:禁止
  coCreatePermission   Int      @default(0) // 0:所有人 1:关注我的 2:我关注的 3:互相关注 4:禁止
  followingListVisible Boolean  @default(true)
  followersListVisible Boolean  @default(true)
  showOnlineStatus     Boolean  @default(true)
  notifyLike           Boolean  @default(true)
  notifyComment        Boolean  @default(true)
  notifyFollow         Boolean  @default(true)
  notifySquat          Boolean  @default(true)
  notifySystem         Boolean  @default(true)
  notifyOrder          Boolean  @default(true)
  language             String   @default("zh-CN")
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

model StudentVerify {
  id         String              @id @default(cuid())
  userId     String              @unique
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName   String
  idCard     String?
  studentId  String
  schoolName String
  schoolId   String?             @map("school_id")
  school     School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  major      String?
  grade      String?
  cardImage  String?
  status     StudentVerifyStatus @default(PENDING)
  remark     String?
  verifiedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([schoolId])
  @@map("student_verifies")
}

model School {
  id         String   @id @default(cuid())
  name       String
  shortName  String?  @map("short_name")
  type       String   @default("university") // university / college / highschool / middleschool / primary / other
  province   String?
  city       String?
  district   String?
  address    String?
  latitude   Decimal? @db.Decimal(10, 6)
  longitude  Decimal? @db.Decimal(10, 6)
  campusName String?  @map("campus_name")
  logo       String?
  cover      String?
  regionId   String?  @map("region_id")
  region     Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  sortOrder  Int      @default(0) @map("sort_order")
  remark     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  studentVerifies StudentVerify[]

  @@index([regionId])
  @@index([name])
  @@index([province, city])
  @@map("schools")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  type        RoleType
  description String?
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  action      String
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, roleId, regionId])
  @@map("user_roles")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Block {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
  @@map("blocks")
}

model BrowseHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // post, product, circle, second_hand
  targetId   String
  title      String?
  image      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@map("browse_histories")
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@map("user_tags")
}

// ==================== 区域系统 ====================

model Region {
  id            String  @id @default(cuid())
  name          String
  code          String  @unique
  description   String?
  cover         String?
  logo          String?
  address       String?
  latitude      Float?
  longitude     Float?
  radius        Int     @default(5000) // 距离限制，单位米
  distanceLimit Int?    @default(0) // 0=关闭距离限制
  studentOnly   Boolean @default(false)
  isOpen        Boolean @default(true)
  sortOrder     Int     @default(0)
  settings      Json? // 区域配置(保留兼容)

  // 区域负责人
  managerName      String? @map("manager_name")
  managerPhone     String? @map("manager_phone")
  managerWechat    String? @map("manager_wechat")
  managerAccountId String? @map("manager_account_id")
  managerUserId    String? @map("manager_user_id")

  // 基础信息
  regionType      String? @default("other") // campus / community / other
  isHot           Boolean @default(false)
  regionCoverMode String? @default("cover") // cover / popup

  // 财务配置
  balance         Decimal? @default(0) @db.Decimal(12, 2)
  minWithdraw     Decimal? @default(0) @db.Decimal(10, 2)
  maxWithdraw     Decimal? @default(0) @db.Decimal(10, 2)
  withdrawFee     Decimal? @default(0) @db.Decimal(10, 2)
  withdrawRate    Decimal? @default(0) @db.Decimal(8, 4)
  commissionRate  Decimal? @default(0) @db.Decimal(8, 4)
  selfUnbanFee    Decimal? @default(0) @db.Decimal(10, 2)
  // 财务：区域累计佣金
  totalCommission Decimal? @default(0) @db.Decimal(12, 2)

  // 显示设置
  showHotList                Boolean @default(false)
  hotFeaturedDisplay         String? @default("none") // none / hot / featured / mixed
  isForceGuidance            Boolean @default(false)
  regionSwitchSupported      Boolean @default(true)
  privateMessageEnabled      Boolean @default(true)
  contactsRequireStudentAuth Boolean @default(false)
  onlyStudentAuthUsers       Boolean @default(false)
  groupChatEnabled           Boolean @default(false)
  enableQrcodeFilter         Boolean @default(false)

  // 页面装修配置
  showCarousel     Boolean @default(true)
  showAnnouncement Boolean @default(true)
  showKingkong     Boolean @default(true)
  homeFeatureStyle String? @default("default") // default / card / simple

  // 页面布局
  homeNavLayout     Int?    @default(1) // 1-9
  messagePageLayout String? @default("default") // default / xiaohongshu
  profilePageLayout String? @default("default")

  // 复杂 JSON 配置
  carouselImages      Json?
  regionTabs          Json?
  homeLeaderboard     Json?
  messageIcons        Json?
  messageNavigation   Json?
  profileLayoutItems  Json?
  homeNavLayoutConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  managerAccount          AdminAccount?            @relation("RegionManagerAccount", fields: [managerAccountId], references: [id], onDelete: SetNull)
  managerUser             User?                    @relation("RegionManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)
  admins                  UserRole[]
  banners                 RegionBanner[]
  notices                 RegionNotice[]
  navs                    RegionNav[]
  tabBar                  RegionTabBar?
  posts                   Post[]
  circles                 Circle[]
  merchants               Merchant[]
  deliveryConfigs         DeliveryConfig[]
  activities              Activity[]
  secondHands             SecondHand[]
  cityAgents              CityAgent[]
  cityAgentApps           CityAgentApplication[]
  priceAdjustments        ProductPriceAdjustment[]
  merchantSettings        RegionMerchantSettings?
  secondHandRegionSetting SecondHandRegionSetting?
  coupons                 Coupon[]
  datingPackages          DatingPackage[]
  datingConfig            DatingConfig?
  datingProfiles          DatingProfile[]
  balanceLogs             RegionBalanceLog[]
  systemAlerts            SystemAlert[]
  schools                 School[]
  growthExperiences       UserExperience[]
  anonymousIdentities     AnonymousIdentity[]

  @@index([managerUserId])
  @@map("regions")
}

model RegionBanner {
  id        String    @id @default(cuid())
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  title     String?
  image     String
  link      String?
  sortOrder Int       @default(0)
  isShow    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("region_banners")
}

model RegionNotice {
  id        String    @id @default(cuid())
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      String    @default("normal") // normal, important, emergency
  isTop     Boolean   @default(false)
  isShow    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("region_notices")
}

model RegionNav {
  id        String   @id @default(cuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name      String
  icon      String
  link      String
  type      String   @default("page") // page, miniapp, web
  sortOrder Int      @default(0)
  isShow    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("region_navs")
}

model RegionTabBar {
  id        String   @id @default(cuid())
  regionId  String   @unique
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  config    Json // TabBar 配置
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("region_tab_bars")
}

// ==================== 内容社区 ====================

model Post {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId            String?
  region              Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  circleId            String?
  circle              Circle?            @relation(fields: [circleId], references: [id], onDelete: SetNull)
  type                PostType           @default(TEXT)
  interactionIntent   String             @default("share")
  status              PostStatus         @default(PENDING)
  title               String?
  content             String             @db.Text
  location            String?
  latitude            Float?
  longitude           Float?
  viewCount           Int                @default(0)
  likeCount           Int                @default(0)
  commentCount        Int                @default(0)
  favoriteCount       Int                @default(0)
  shareCount          Int                @default(0)
  isTop               Boolean            @default(false)
  topExpireAt         DateTime?
  isCoCreate          Boolean            @default(false)
  auditStatus         String             @default("pending") // pending, approved, rejected
  auditReason         String?
  isAnonymous         Boolean            @default(false)
  anonymousIdentityId String?
  anonymousIdentity   AnonymousIdentity? @relation("PostAnonymousIdentity", fields: [anonymousIdentityId], references: [id], onDelete: SetNull)
  anonymousName       String?
  anonymousAvatar     String?
  isEssence           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  // Relations
  media            PostMedia[]
  topics           PostTopic[]
  comments         Comment[]
  likes            Like[]
  favorites        Favorite[]
  votes            Vote[]
  collaborators    PostCollaborator[]
  mentions         PostMention[]
  reports          Report[]
  echoInteractions PostEchoInteraction[]
  shareLinks       PostShareLink[]

  @@index([userId, createdAt])
  @@index([regionId, status, createdAt])
  @@index([regionId, status, auditStatus, createdAt])
  @@index([circleId, status, createdAt])
  @@index([circleId, status, auditStatus, createdAt])
  @@index([status, isTop, createdAt])
  @@index([type])
  @@index([regionId, interactionIntent, createdAt])
  @@index([isAnonymous, anonymousIdentityId])
  @@map("posts")
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  thumb     String?
  width     Int?
  height    Int?
  duration  Int? // 视频/音频时长，单位秒
  size      Int? // 文件大小，单位字节
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("post_media")
}

/// 用户对校园回声笔记的轻互动。一个用户对同一笔记的同一种互动只保留一条记录。
model PostEchoInteraction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@unique([postId, userId, action])
  @@index([postId, action, createdAt])
  @@index([userId, createdAt])
  @@map("post_echo_interactions")
}

model PostTextCoverTemplate {
  id              String   @id @default(cuid())
  regionId        String?
  name            String
  enabled         Boolean  @default(true)
  isDefault       Boolean  @default(false)
  backgroundType  String   @default("color")
  backgroundColor String   @default("#F7F3EA")
  gradientStart   String?
  gradientEnd     String?
  backgroundImage String?
  textColor       String   @default("#222222")
  accentColor     String   @default("#FF4D5A")
  titleFontSize   Int      @default(30)
  bodyFontSize    Int      @default(24)
  maxTitleChars   Int      @default(24)
  maxSummaryChars Int      @default(72)
  maxLines        Int      @default(6)
  coverHeight     Int      @default(350)
  showTopic       Boolean  @default(true)
  showCircle      Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([regionId, enabled, priority])
  @@map("post_text_cover_templates")
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  cover       String?
  description String?
  postCount   Int      @default(0)
  followCount Int      @default(0)
  isHot       Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("active") // active, disabled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts   PostTopic[]
  circles CircleTopicGroup[]

  @@map("topics")
}

model PostTopic {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, topicId])
  @@map("post_topics")
}

model Comment {
  id                  String             @id @default(cuid())
  postId              String
  post                Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId            String?
  parent              Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies             Comment[]          @relation("CommentReplies")
  mentions            CommentMention[]
  content             String
  likeCount           Int                @default(0)
  isTop               Boolean            @default(false)
  status              String             @default("active") // active, hidden, deleted
  auditStatus         String             @default("pending") // pending, approved, rejected
  auditReason         String?
  images              Json?
  isAnonymous         Boolean            @default(false)
  anonymousIdentityId String?
  anonymousIdentity   AnonymousIdentity? @relation("CommentAnonymousIdentity", fields: [anonymousIdentityId], references: [id], onDelete: SetNull)
  anonymousName       String?
  anonymousAvatar     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@index([postId, createdAt])
  @@index([postId, status, auditStatus, parentId, createdAt])
  @@index([parentId])
  @@index([isAnonymous, anonymousIdentityId])
  @@map("comments")
}

model PostMention {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation("MentionedPostUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_mentions")
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation("MentionedCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@index([userId, createdAt])
  @@map("comment_mentions")
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // post, comment
  targetId   String
  createdAt  DateTime @default(now())

  post Post? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "like_post_fk")

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // post, product, second_hand
  targetId   String
  createdAt  DateTime @default(now())

  post Post? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "favorite_post_fk")

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("favorites")
}

model Vote {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  options   Json // [{id, text, count}]
  maxSelect Int       @default(1)
  endAt     DateTime?
  createdAt DateTime  @default(now())

  @@map("votes")
}

model VoteRecord {
  id        String   @id @default(cuid())
  voteId    String
  userId    String
  options   Json // [optionId]
  createdAt DateTime @default(now())

  @@unique([voteId, userId])
  @@map("vote_records")
}

model PostCollaborator {
  id            String    @id @default(cuid())
  postId        String
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviterId     String?
  status        String    @default("accepted") // pending, accepted, rejected
  inviteMessage String?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  operatorId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([postId, userId])
  @@index([userId, status, createdAt])
  @@index([postId, status])
  @@map("post_collaborators")
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String?
  reported   User?     @relation("Reported", fields: [reportedId], references: [id], onDelete: SetNull)
  targetType String // post, comment, user, message, merchant
  targetId   String
  reason     String
  detail     String?
  images     Json?
  status     String    @default("pending") // pending, processing, resolved, rejected
  result     String?
  handlerId  String?
  handledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post Post? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "report_post_fk")

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// ==================== 圈子系统 ====================

model Circle {
  id           String         @id @default(cuid())
  name         String
  icon         String?
  cover        String?
  description  String?
  regionId     String?
  region       Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  ownerUserId  String?
  joinType     CircleJoinType @default(OPEN)
  isOfficial   Boolean        @default(false)
  memberCount  Int            @default(0)
  postCount    Int            @default(0)
  maxMembers   Int            @default(500)
  tags         Json?
  status       String         @default("active") // active, dissolved
  auditStatus  String         @default("approved") // pending, approved, rejected
  auditReason  String?
  announcement String?        @db.Text
  rules        String?        @db.Text
  lastActiveAt DateTime?
  riskScore    Int            @default(0)
  price        Decimal?       @db.Decimal(10, 2)
  paidJoin     Boolean        @default(false)
  inviteCode   String?
  deadline     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  members      CircleMember[]
  channels     CircleChannel[]
  topicGroups  CircleTopicGroup[]
  topicHeaders CircleTopicHeader[]
  payments     CirclePayment[]
  posts        Post[]

  @@index([ownerUserId])
  @@index([auditStatus, status])
  @@index([regionId, status, createdAt])
  @@map("circles")
}

model CircleTopicHeader {
  id          String   @id @default(cuid())
  circleId    String
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics CircleTopicGroup[]

  @@unique([circleId, title])
  @@index([circleId, sortOrder])
  @@map("circle_topic_headers")
}

model CircleMember {
  id          String           @id @default(cuid())
  circleId    String
  circle      Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CircleMemberRole @default(MEMBER)
  status      String           @default("active") // pending, active, muted, banned, rejected
  nickName    String?
  muteEndAt   DateTime?
  muteReason  String?
  auditReason String?
  auditedAt   DateTime?
  operatorId  String?
  joinAt      DateTime         @default(now())
  lastReadAt  DateTime?

  @@unique([circleId, userId])
  @@index([circleId, status])
  @@index([userId, status])
  @@map("circle_members")
}

model CircleChannel {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text") // text, voice, notice
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("circle_channels")
}

model CircleTopicGroup {
  id        String             @id @default(cuid())
  circleId  String
  circle    Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  headerId  String?
  header    CircleTopicHeader? @relation(fields: [headerId], references: [id], onDelete: SetNull)
  topicId   String
  topic     Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())

  @@unique([circleId, topicId])
  @@index([headerId, sortOrder])
  @@map("circle_topic_groups")
}

model CirclePayment {
  id         String    @id @default(cuid())
  circleId   String
  circle     Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal   @db.Decimal(10, 2)
  payChannel String?
  status     String    @default("pending") // pending, paid, refunded
  payTime    DateTime?
  createdAt  DateTime  @default(now())

  @@map("circle_payments")
}

// ==================== 商家/商城 ====================

model Merchant {
  id                   String    @id @default(cuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  regionId             String?
  region               Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  name                 String
  businessType         String    @default("takeaway") @map("business_type") // takeaway, dorm_shop
  deliveryMode         String    @default("platform_rider") @map("delivery_mode") // takeaway uses platform_rider; dorm_shop is fixed to self_delivery
  deliveryFee          Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  minOrderAmount       Decimal   @default(1) @map("min_order_amount") @db.Decimal(10, 2)
  packagingFee         Decimal   @default(0) @map("packaging_fee") @db.Decimal(10, 2)
  deliveryTimeMinutes  Int       @default(30) @map("delivery_time_minutes")
  logo                 String?
  cover                String?
  businessLicenseUrl   String?   @map("business_license_url")
  foodSafetyLicenseUrl String?   @map("food_safety_license_url")
  phone                String?
  contactPerson        String?
  address              String?
  dormBuilding         String?   @map("dorm_building")
  dormRoom             String?   @map("dorm_room")
  studentVerified      Boolean   @default(false) @map("student_verified")
  latitude             Float?
  longitude            Float?
  businessHours        String?
  closedNotice         String?
  description          String?
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status               String    @default("pending") // pending, approved, rejected, closed
  rejectReason         String?
  rating               Float     @default(5)
  saleCount            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products         Product[]
  orders           Order[]
  freightTemplates FreightTemplate[]
  settlements      MerchantSettlement[]
  priceAdjustments ProductPriceAdjustment[]
  groupBuyPackages GroupBuyPackage[]
  coupons          Coupon[]

  @@index([userId])
  @@index([businessType, status])
  @@index([businessType, deliveryMode])
  @@map("merchants")
}

model Category {
  id           String    @id @default(cuid())
  parentId     String?
  parent       Category? @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  name         String
  icon         String?
  sortOrder    Int       @default(0)
  isShow       Boolean   @default(true)
  type         String    @default("product") // product, post, circle
  businessType String    @default("takeaway") @map("business_type") // takeaway, dorm_shop
  status       String    @default("active") // active, disabled, deleted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  children         Category[]               @relation("CategoryChildren")
  products         Product[]
  merchants        Merchant[]
  priceAdjustments ProductPriceAdjustment[]

  @@index([businessType, type, status])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  images      Json
  detail      String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  originPrice Decimal?  @db.Decimal(10, 2)
  stock       Int       @default(0)
  saleCount   Int       @default(0)
  unit        String?
  weight      Int? // 单位克
  status      String    @default("on_sale") // on_sale, off_sale, deleted
  isHot       Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  skus           SKU[]
  modifierGroups ProductModifierGroup[]
  cartItems      Cart[]
  orderItems     OrderItem[]
  reviews        Review[]
  promotions     PromotionProduct[]

  @@index([merchantId, status])
  @@index([categoryId])
  @@map("products")
}

model SKU {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  specs       Json // [{key: "颜色", value: "红色"}]
  price       Decimal  @db.Decimal(10, 2)
  originPrice Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  image       String?
  status      String   @default("on_sale")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  Cart[]
  orderItems OrderItem[]

  @@map("skus")
}

model ProductModifierGroup {
  id         String                  @id @default(cuid())
  productId  String
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  type       String                  @default("attribute") // attribute, extra
  isRequired Boolean                 @default(false)
  maxSelect  Int                     @default(1)
  sortOrder  Int                     @default(0)
  status     String                  @default("on_sale")
  options    ProductModifierOption[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([productId, status, sortOrder])
  @@map("product_modifier_groups")
}

model ProductModifierOption {
  id        String               @id @default(cuid())
  groupId   String
  group     ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal              @default(0) @db.Decimal(10, 2)
  stock     Int?
  sortOrder Int                  @default(0)
  status    String               @default("on_sale")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([groupId, status, sortOrder])
  @@map("product_modifier_options")
}

model Cart {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId              String?
  sku                SKU?     @relation(fields: [skuId], references: [id], onDelete: SetNull)
  selectionKey       String   @default("")
  modifierSelections Json?
  quantity           Int      @default(1)
  selected           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, productId, skuId, selectionKey])
  @@map("carts")
}

model Order {
  id                    String          @id @default(cuid())
  orderNo               String          @unique
  userId                String
  user                  User            @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  merchantId            String
  merchant              Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  businessType          String          @default("takeaway") @map("business_type") // takeaway, dorm_shop
  deliveryMode          String          @default("platform_rider") @map("delivery_mode") // platform_rider, self_delivery, rider_delivery
  deliveryDisplayMode   String          @default("status_nodes")
  riderId               String?         @map("rider_id")
  status                OrderStatus     @default(PENDING_PAY)
  totalAmount           Decimal         @db.Decimal(10, 2)
  discountAmount        Decimal         @default(0) @db.Decimal(10, 2)
  freightAmount         Decimal         @default(0) @db.Decimal(10, 2)
  originalFreightAmount Decimal         @default(0) @db.Decimal(10, 2)
  deliveryDistanceMeters Int?           @map("delivery_distance_meters")
  packagingAmount       Decimal         @default(0) @map("packaging_amount") @db.Decimal(10, 2)
  subsidyAmount         Decimal         @default(0) @db.Decimal(10, 2)
  payAmount             Decimal         @db.Decimal(10, 2)
  payChannel            PaymentChannel?
  payTime               DateTime?
  scheduledDeliveryTime DateTime?       @map("scheduled_delivery_time")
  fulfillmentStartTime  DateTime?       @map("fulfillment_start_time")
  stockReserved         Boolean         @default(false) @map("stock_reserved")
  merchantAcceptTime    DateTime?       @map("merchant_accept_time")
  readyTime             DateTime?       @map("ready_time")
  acceptTime            DateTime?       @map("accept_time")
  pickupTime            DateTime?       @map("pickup_time")
  deliverTime           DateTime?
  receiveTime           DateTime?
  completeTime          DateTime?
  cancelTime            DateTime?
  cancelReason          String?
  remark                String?
  receiverName          String
  receiverPhone         String
  receiverAddress       String
  trackingNo            String?
  trackingCompany       String?
  refundStatus          String          @default("none") // none, refunding, refunded
  refundAmount          Decimal?        @db.Decimal(10, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items     OrderItem[]
  refunds   Refund[]
  reviews   Review[]
  orderLogs OrderLog[]

  @@index([userId, createdAt])
  @@index([merchantId, status])
  @@index([businessType, status])
  @@index([deliveryMode, status])
  @@index([fulfillmentStartTime, status])
  @@index([riderId, status])
  @@index([orderNo])
  @@map("orders")
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId              String?
  sku                SKU?    @relation(fields: [skuId], references: [id], onDelete: SetNull)
  productName        String
  productImage       String
  skuSpecs           Json?
  modifierSelections Json?
  price              Decimal @db.Decimal(10, 2)
  quantity           Int
  totalPrice         Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model Refund {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundNo     String    @unique
  amount       Decimal   @db.Decimal(10, 2)
  reason       String
  images       Json?
  status       String    @default("pending") // pending, approved, rejected, completed
  rejectReason String?
  refundTime   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("refunds")
}

model OrderAppeal {
  id             String             @id @default(cuid())
  appealNo       String             @unique
  orderType      String
  orderId        String
  orderNo        String
  userId         String
  regionId       String?
