  nickName       String?
  unreadCount    Int          @default(0)
  lastReadMsgId  String?
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  type            MessageType
  content         String
  clientMessageId String?
  extra           Json? // 额外数据，如图片URL、位置等
  isRecalled      Boolean      @default(false)
  recalledAt      DateTime?
  readCount       Int          @default(0)
  createdAt       DateTime     @default(now())

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId         String?
  type             NotificationType
  scene            String?
  title            String
  content          String
  data             Json?
  linkType         String?
  linkValue        String?
  channelMask      Json?
  deliveryStatus   String           @default("pending")
  deliveryReport   Json?
  deliveryAttempts Int              @default(0)
  lastDeliveryAt   DateTime?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  hiddenAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, hiddenAt, createdAt])
  @@index([regionId, type, createdAt])
  @@index([deliveryStatus, createdAt])
  @@map("notifications")
}

model OfficialAssistantMessage {
  id          String    @id @default(cuid())
  regionId    String?
  category    String    @default("campus") // campus, system, service
  renderType  String    @default("card") // text, card
