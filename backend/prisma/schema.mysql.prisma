  appealType     String
  description    String             @db.Text
  evidenceImages Json?
  contactPhone   String?
  status         String             @default("pending")
  handlerId      String?
  latestReply    String?            @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  events         OrderAppealEvent[]

  @@unique([orderType, orderId])
  @@index([userId, createdAt])
  @@index([regionId, status, createdAt])
  @@map("order_appeals")
}

model OrderAppealEvent {
  id        String      @id @default(cuid())
  actionKey String?     @unique
  appealId  String
  appeal    OrderAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  action    String
  actorType String
  actorId   String?
  status    String?
  content   String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([appealId, createdAt])
  @@map("order_appeal_events")
}

model AssistantTicket {
  id            String                 @id @default(cuid())
  ticketNo      String                 @unique
  userId        String
  regionId      String
  category      String                 @default("other")
  content       String                 @db.Text
  status        String                 @default("pending")
  handlerId     String?
  latestReply   String?                @db.Text
  unreadForUser Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  replies       AssistantTicketReply[]

  @@index([userId, regionId, updatedAt])
  @@index([regionId, status, updatedAt])
  @@map("assistant_tickets")
}

model AssistantTicketReply {
  id              String          @id @default(cuid())
  ticketId        String
  ticket          AssistantTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType      String
  senderId        String?
  clientMessageId String?
  content         String          @db.Text
  createdAt       DateTime        @default(now())

  @@unique([senderId, clientMessageId])
  @@index([ticketId, createdAt])
  @@map("assistant_ticket_replies")
}

model Review {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchantId  String?
  rating      Int       @default(5)
  content     String?
  images      Json?
  tags        Json?
  isAnonymous Boolean   @default(false)
  reply       String?
  replyAt     DateTime?
  status      String    @default("active") // active, hidden
  createdAt   DateTime  @default(now())

  // 新评价写入订单与用户的稳定键；旧数据保持为空，避免上线时因历史重复评价阻塞迁移。
  dedupeKey String? @unique

  @@map("reviews")
}

model Promotion {
  id        String   @id @default(cuid())
  name      String
  type      String // full_reduction, discount
  rules     Json // {full: 100, reduction: 10}
  startAt   DateTime
  endAt     DateTime
  isGlobal  Boolean  @default(false)
  status    String   @default("active")
  createdAt DateTime @default(now())

  products PromotionProduct[]

  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@map("promotion_products")
}

model FreightTemplate {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  rules      Json // [{region: [], firstWeight: 1000, firstPrice: 10, continueWeight: 500, continuePrice: 5}]
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("freight_templates")
}

// ==================== 外卖/跑腿 ====================

model DeliveryConfig {
  id            String           @id @default(cuid())
  regionId      String
  region        Region           @relation(fields: [regionId], references: [id], onDelete: Cascade)
  type          DeliveryTaskType
  basePrice     Decimal          @db.Decimal(10, 2)
