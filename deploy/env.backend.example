# Lingmeng Backend .env for Baota / Production
# 首次部署建议先启用安装向导，初始化完成后改为 false 并重启后端。

NODE_ENV=production
PORT=3000

SETUP_WIZARD=true
SETUP_TOKEN=please-change-this-long-random-token

# 宝塔 MySQL 示例：
# 账号、密码、数据库名请在宝塔「数据库」里创建后填写。
DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name

# 宝塔 Redis 示例：
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=please-generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# 推荐填你的后台域名和 API 域名，多个用英文逗号分隔。
CORS_ORIGIN=https://admin.example.com,https://api.example.com

# 微信小程序，必填。
WX_MINI_APPID=
WX_MINI_SECRET=

# 微信支付，没有开通可以先留空。
WX_PAY_MCHID=
WX_PAY_APIV3_KEY=
WX_PAY_CERT_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_PLATFORM_CERT_PATH=
WX_PAY_NOTIFY_URL=
WX_PAY_REFUND_NOTIFY_URL=

# 腾讯云 COS，没有开通可以先留空，后台系统配置里也能后补。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=20

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
