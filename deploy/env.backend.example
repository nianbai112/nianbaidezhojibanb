# Lingmeng Backend .env for Baota / Production
# 客户首次运行包标准：首次部署必须保持 DB_IS_INSTALLED=0、SETUP_WIZARD=true。
# 安装向导成功后系统会自动写入 DB_IS_INSTALLED=1、SETUP_WIZARD=false。

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SERVICE_ROLE=api
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
APP_VERSION=1.0.45-selfhosted.1

# 数据库配置
# 默认推荐宝塔 MySQL；也支持 PostgreSQL。首次安装后不要随意切换 DB_PROVIDER。
DB_PROVIDER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=lingmeng
DB_PASSWORD=
DB_NAME=lingmeng
DB_SCHEMA=public
DB_CHARSET=utf8mb4
DATABASE_URL=

# 系统是否安装成功：0 表示未安装/允许安装向导，1 表示已安装。
DB_IS_INSTALLED=0
SETUP_WIZARD=true

# 宝塔 Redis 示例：
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=please-generate-a-long-random-secret-at-least-32-chars
ADMIN_JWT_SECRET=please-generate-another-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 首次安装会创建一次，后续不会覆盖已存在账号。
# 后台登录账号：admin
# 后台初始密码：首次部署时请自行生成强随机密码
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD

# 校园地图 DWG 自动导入需要 ODA File Converter。
# 常见 Linux 路径：/usr/bin/ODAFileConverter 或 /opt/ODAFileConverter/ODAFileConverter
# 不填时后端会自动探测常见路径；DXF/GeoJSON/图片导入不依赖此项。
ODA_FILE_CONVERTER=

# 推荐填你的后台域名和 API 域名，多个用英文逗号分隔。
CORS_ORIGIN=https://admin.example.com,https://api.example.com

# 微信小程序、对象存储、支付可以首次安装后在后台系统配置里补齐。
WX_MINI_APPID=
WX_MINI_SECRET=

# 阿里云短信服务：手机号验证码登录需要。签名和模板必须在阿里云短信控制台审核通过。
# 模板变量必须包含 ${code}，例如：您的验证码为${code}，5分钟内有效。
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou

# 微信支付，没有开通可以先留空。
WX_PAY_MCHID=
WX_PAY_APIV3_KEY=
WX_PAY_CERT_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_PLATFORM_CERT_PATH=
WX_PAY_NOTIFY_URL=
WX_PAY_REFUND_NOTIFY_URL=

# 腾讯云 COS，没有开通可以先留空，后台系统配置里也能后补。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=20

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MESSAGE=请求过于频繁，请稍后再试

AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
