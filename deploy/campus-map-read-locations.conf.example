# Place inside the existing HTTPS server {} block. Confirm no existing ^~
# /api/ location bypasses these regex locations. Do NOT expose port 3002.
location ~ ^/(?:api/)?campus-map/(?:read-snapshot|read-access)$ {
    return 404;
}

location ~ ^/(?:api/)?campus-map/(?:active|site|version|site/version)$ {
    limit_req zone=campus_map_total burst=200 nodelay;
    limit_req_status 429;
    limit_conn campus_map_connections 256;
    limit_conn_status 429;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    # Overwrite rather than append untrusted client forwarding headers.
    # If using CDN, configure its trusted real_ip sources BEFORE this step.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 1s;
    proxy_send_timeout 4s;
    proxy_read_timeout 4s;
    # A failure must not automatically dump all map traffic back onto the core API.
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_pass $campus_map_read_upstream;
}
